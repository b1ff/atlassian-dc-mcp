{
  "name": "atlassian-dc-mcp",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/b1ff/atlassian-dc-mcp.git"
  },
  "homepage": "https://github.com/b1ff/atlassian-dc-mcp#readme",
  "bugs": {
    "url": "https://github.com/b1ff/atlassian-dc-mcp/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "npm run test --workspaces",
    "dev:jira": "npm run dev --workspace=@atlassian-dc-mcp/jira",
    "dev:confluence": "npm run dev --workspace=@atlassian-dc-mcp/confluence",
    "dev:bitbucket": "npm run dev --workspace=@atlassian-dc-mcp/bitbucket",
    "debug": "node mcp-live-debug.js",
    "debug:verbose": "node mcp-live-debug.js --verbose",
    "debug:ts": "nodemon --exec tsx",
    "publish:ci": "node scripts/version-packages.js && lerna publish from-package --yes",
    "lerna": "lerna"
  },
  "overrides": {
    "tar": "7.5.22",
    "nx": {
      "undici": "7.30.1"
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "2.12.0",
    "@swc/core": "1.16.20",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "jest": "30.5.2",
    "lerna": "10.1.1",
    "nodemon": "3.1.14",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=11.10.0 <12"
  },
  "packageManager": "npm@11.21.1"
}
